# Planora — environment template. Copy to .env.local and fill in.
# Never commit .env.local. See DEVELOPMENT_PLAN.md §5.1.

# --- Database (Phase 2) -------------------------------------------------
# Supabase Postgres, reached over the pooler in transaction mode.
# Prepared statements must be off with a transaction-mode pooler.
#
# In production these two are different connections and that matters:
#   DATABASE_URL            the pooler,  port 6543 — what the app uses
#   MIGRATION_DATABASE_URL  direct,      port 5432 — what drizzle-kit uses,
#                           because it takes an advisory lock and keeps the
#                           session, which a transaction pooler will not hold.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Auth (Phase 3) -----------------------------------------------------
# 32 characters or more. Signs sessions, verification links and file URLs.
BETTER_AUTH_SECRET=""
# The address people actually open. Verification and invitation links are
# built from it, so in production it is the deployment's own URL.
BETTER_AUTH_URL="http://localhost:3000"

# --- Storage (Phase 7) --------------------------------------------------
# The only place the Supabase SDK is used.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"

# With no Supabase credentials, attachments are written to `.storage/` and
# served by /api/files behind a signed URL — the §9.1 fallback. Outside
# development that has to be asked for by name: STORAGE_DRIVER="local".
STORAGE_DRIVER=""
STORAGE_DIR=""

# --- Email (Phase 3) ----------------------------------------------------
# Empty in development: with no Resend key, mail goes to the local inbox at
# http://localhost:8025 instead of being sent. In production a key is
# required — the application refuses to start without one rather than post
# account verification to a machine that is not there.
RESEND_API_KEY=""
MAILPIT_URL="http://127.0.0.1:8025"
EMAIL_FROM="Planora <no-reply@localhost>"

# --- AI (Phase 12) ------------------------------------------------------
ANTHROPIC_API_KEY=""
