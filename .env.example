# Planora — environment template. Copy to .env.local and fill in.
# Never commit .env.local. See DEVELOPMENT_PLAN.md §5.1.

# --- Database (Phase 2) -------------------------------------------------
# Supabase Postgres, reached over the pooler in transaction mode.
# Prepared statements must be off with a transaction-mode pooler.
#
# In production these two are different connections and that matters:
#   DATABASE_URL            the pooler,  port 6543 — what the app uses
#   MIGRATION_DATABASE_URL  direct,      port 5432 — what drizzle-kit uses,
#                           because it takes an advisory lock and keeps the
#                           session, which a transaction pooler will not hold.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# The integration suite (pnpm test:db) truncates every table before each test,
# so it never runs on the database above. It uses this one when set, otherwise
# DATABASE_URL with the database renamed to planora_test, created on first run.
# A URL that is not on this machine, or whose database name does not end in
# _test, is refused.
TEST_DATABASE_URL=""

# --- The barrier (Phase 10, ADR 0002) -----------------------------------
# Row-level security is only a barrier if the application cannot bypass it.
# APP_DATABASE_URL names the role migration 0008 creates; with it empty, every
# request still opens its scope and applies its settings, and the policies
# simply do not bite, because DATABASE_URL is the owner. That is how the phase
# was landed, and how it can be rolled back: one variable.
#
#   APP_DATABASE_URL     connects as planora_app — no BYPASSRLS, no grant on
#                        the identity tables. Almost everything.
#   SYSTEM_DATABASE_URL  the four cross-workspace paths: Better Auth, the
#                        outbox and the clock, email and digests, and the first
#                        workspace an account gets. Optional: it falls back to
#                        DATABASE_URL, which is the owner and bypasses RLS.
#
# Give the role a password first — the migration deliberately does not:
#   alter role planora_app with login password '…';
# See docs/DEPLOY.md, 7.
APP_DATABASE_URL=""
SYSTEM_DATABASE_URL=""

# --- The restore drill (Phase 10) ---------------------------------------
# `pnpm db:restore-drill` dumps a database and rebuilds it in a scratch one,
# then compares row counts, migrations and policies. It refuses anything that
# is not on this machine as a target. DRILL_SOURCE_DATABASE_URL is what to
# dump when it is not DATABASE_URL — the production session pooler, for the
# real drill. DRILL_POSTGRES_IMAGE names a pg_dump matching a server newer
# than the local container. See docs/DEPLOY.md, 6.
DRILL_SOURCE_DATABASE_URL=""
DRILL_SCRATCH_DATABASE_URL=""
DRILL_POSTGRES_IMAGE=""

# --- Auth (Phase 3) -----------------------------------------------------
# 32 characters or more. Signs sessions, verification links and file URLs.
BETTER_AUTH_SECRET=""
# The address people actually open. Verification and invitation links are
# built from it, so in production it is the deployment's own URL.
BETTER_AUTH_URL="http://localhost:3000"

# --- Storage (Phase 7) --------------------------------------------------
# The only place the Supabase SDK is used — and, since Phase 10, also read at
# BUILD time: the Content-Security-Policy names the bucket's origin, and a
# variable that only exists at runtime leaves it out, so every attachment
# image is refused by the browser in production and nowhere else.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"

# With no Supabase credentials, attachments are written to `.storage/` and
# served by /api/files behind a signed URL — the §9.1 fallback. Outside
# development that has to be asked for by name: STORAGE_DRIVER="local".
STORAGE_DRIVER=""
STORAGE_DIR=""

# --- Email (Phase 3) ----------------------------------------------------
# Empty in development: with no Resend key, mail goes to the local inbox at
# http://localhost:8025 instead of being sent. In production a key is
# required — the application refuses to start without one rather than post
# account verification to a machine that is not there.
RESEND_API_KEY=""
MAILPIT_URL="http://127.0.0.1:8025"
# Outside development, mail without a Resend key is an error — unless the
# local inbox is asked for by name, which is how the E2E suite runs.
EMAIL_DRIVER=""
EMAIL_FROM="Planora <no-reply@localhost>"

# --- Development only ---------------------------------------------------
# ENABLE_DEV_ROUTES=1 serves the /dev/ui gallery outside `next dev`; the E2E
# suite sets it. DISABLE_BREACH_CHECK=1 skips the HIBP lookup in the password
# policy so a test run makes no third-party request. Never set in production.
ENABLE_DEV_ROUTES=""
DISABLE_BREACH_CHECK=""

# --- The clock (Phase 9) ------------------------------------------------
# The scheduler route (/api/scheduler) exists only when this is set, and
# answers only to `Authorization: Bearer <CRON_SECRET>`. In production the
# minute tick comes from Supabase's pg_cron (docs/DEPLOY.md, 5) and a daily
# Vercel Cron backs it up; locally, curl it by hand.
CRON_SECRET=""

# --- AI (Phase 12) ------------------------------------------------------
ANTHROPIC_API_KEY=""
